# ─── 数据库 ────────────────────────────
# Docker Compose 内部使用，本地开发可不设
# DATABASE_URL=postgresql+asyncpg://eduflow:eduflow@localhost:5432/eduflow

# ─── JWT ───────────────────────────────
# 生产环境必须修改！
JWT_SECRET=change-me-in-production

# ─── LLM (LiteLLM) ─────────────────────
# 支持 OpenAI / Claude / Gemini 等 100+ 模型
# 详见 https://docs.litellm.ai/docs/providers
LITELLM_API_KEY=your-api-key
LITELLM_BASE_URL=https://api.openai.com/v1
LITELLM_MODEL=gpt-4o-mini

# ─── CORS ─────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── 前端 ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── E2B 代码沙箱（开源 — pip install e2b）─────────
# 获取 API key: https://e2b.dev
# E2B_API_KEY=your-e2b-api-key

# ─── Qdrant 向量数据库（开源）──────────────────
# Docker: docker compose up qdrant
# QDRANT_URL=http://localhost:6333

# ─── Mem0 长期记忆（开源 — pip install mem0ai）─────
# 获取 API key: https://mem0.ai
# MEM0_API_KEY=your-mem0-api-key
